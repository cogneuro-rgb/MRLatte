{
  "name": "frontend",
  "version": "0.2.1",
  "private": true,
  "description": "MRLatte — neuroimaging visualization dashboard",
  "author": "MRLatte",
  "homepage": "./",
  "main": "public/electron.js",
  "proxy": "http://localhost:8001",
  "dependencies": {
    "@niivue/niivue": "^0.68.2",
    "@radix-ui/react-dialog": "^1.1.11",
    "@radix-ui/react-slider": "^1.3.2",
    "clsx": "^2.1.1",
    "jspdf": "^4.2.1",
    "lucide-react": "^0.507.0",
    "nifti-reader-js": "^0.8.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-scripts": "5.0.1",
    "sonner": "^2.0.3",
    "tailwind-merge": "^3.2.0",
    "tailwindcss-animate": "^1.0.7"
  },
  "scripts": {
    "start": "craco start",
    "build": "craco build",
    "test": "craco test",
    "electron:dev": "cross-env MRLATTE_DEV=1 wait-on http://localhost:3000 && electron .",
    "electron:start": "concurrently -k \"craco start\" \"yarn electron:dev\"",
    "electron:build": "craco build && electron-builder",
    "dist:win": "craco build && electron-builder --win --x64",
    "dist:win:full": "craco build && electron-builder --win --x64 -c ../tools/build/electron-full.json",
    "dist:linux": "craco build && electron-builder --linux --x64",
    "dist:mac": "craco build && electron-builder --mac --x64",
    "setup": "yarn install && node ../tools/scripts/modules.mjs add --core",
    "setup:full": "yarn install && node ../tools/scripts/modules.mjs add --all",
    "modules": "node ../tools/scripts/modules.mjs",
    "postinstall": "node ../tools/scripts/modules.mjs postinstall"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "@babel/plugin-proposal-private-property-in-object": "^7.21.11",
    "@craco/craco": "^7.1.0",
    "@emergentbase/visual-edits": "https://assets.emergent.sh/npm/emergentbase-visual-edits-1.0.8.tgz",
    "@eslint/js": "9.23.0",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.2.1",
    "cross-env": "^10.1.0",
    "dotenv": "^17.4.2",
    "electron": "33",
    "electron-builder": "25",
    "eslint": "9.23.0",
    "eslint-plugin-import": "2.31.0",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react": "7.37.4",
    "eslint-plugin-react-hooks": "5.2.0",
    "globals": "15.15.0",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "wait-on": "^9.0.10"
  },
  "packageManager": "yarn@1.22.22+sha512.a6b2f7906b721bba3d67d4aff083df04dad64c399707841b7acf00f6b133b7ac24255f2652fa22ae3534329dc6180534e98d17432037ff6fd140556e2bb3137e",
  "build": {
    "appId": "com.mrlatte.desktop",
    "productName": "MRLatte",
    "copyright": "© MRLatte",
    "directories": {
      "output": "../../MRLatte-build/electron",
      "buildResources": "electron/build-resources"
    },
    "files": [
      "build/**/*",
      "electron/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../../MRLatte-build/MRLatte/python",
        "to": "python"
      },
      {
        "from": "../../MRLatte-build/MRLatte/backend",
        "to": "backend"
      },
      {
        "from": "../../MRLatte-build/MRLatte/dcm2niix",
        "to": "dcm2niix"
      },
      {
        "from": "../../MRLatte-build/MRLatte/scripts",
        "to": "scripts"
      },
      {
        "from": "../../MRLatte-build/MRLatte/modules",
        "to": "modules"
      },
      {
        "from": "../../MRLatte-build/MRLatte/frontend_build",
        "to": "frontend_build"
      }
    ],
    "asar": true,
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "electron/build-resources/icon.ico",
      "artifactName": "MRLatte-Setup-${version}-${arch}.${ext}",
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "MRLatte",
      "installerIcon": "electron/build-resources/icon.ico",
      "uninstallerIcon": "electron/build-resources/icon.ico"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Science",
      "icon": "electron/build-resources/icon.png"
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "category": "public.app-category.healthcare-fitness",
      "icon": "electron/build-resources/icon.icns"
    }
  }
}
