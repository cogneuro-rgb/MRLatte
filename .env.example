# Copy to .env (repo root) and fill in. docker compose reads this automatically.

# Domain Caddy will serve + auto-provision a TLS cert for. Point its A/AAAA
# record at this server first. Example: mrlatte.example.com
DOMAIN=mrlatte.example.com

# NOTE: CORS_ORIGINS, STATIC_DIR and ATLAS_DIR are set for you in
# docker-compose.yml and do not need to go here.
