# Copy to .env (repo root) and fill in. docker compose reads this automatically.

# Domain Caddy will serve + auto-provision a TLS cert for. Point its A/AAAA
# record at this server first. Example: neurovue.example.com
DOMAIN=neurovue.example.com

# MongoDB database name (the Mongo service itself needs no credentials by default
# since it is only reachable on the internal compose network).
DB_NAME=neurovue

# NOTE: MONGO_URL, CORS_ORIGINS, STATIC_DIR and LESION_DIR are set for you in
# docker-compose.yml and do not need to go here.
