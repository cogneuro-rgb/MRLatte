# Tract dissection: large tractogram files and generated results.
# NOTE: S35_1mm.trk (~673 MB) is NOT committed on purpose — GitHub rejects files
# >100 MB. Keep it on the build machine at backend/tracts/S35_1mm.trk; the offline
# bundle build (build/assemble-bundle.ps1) copies it into the installer from there.
backend/tracts/*.trk
backend/tracts/*.tck
backend/tract_results/

# Large tract-atlas source data (only built artifacts are committed)
HCP1065/
HCP824/
IIT_bundles/

# Patient-derived compute outputs — NEVER publish (privacy). These hold results
# generated from patient scans and must not go to any remote.
backend/dicom_results/
backend/lnm_results/
backend/roi_results/
backend/summary_results/

# 131 MB — exceeds GitHub's 100 MB per-file limit. Kept on the build machine;
# build/assemble-bundle.ps1 pulls it into the installer. (LFS-tracked separately
# in the clean release repo.)
DaLnm/lnm_bundle_d100.npz
