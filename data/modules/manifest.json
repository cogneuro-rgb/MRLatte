    },
    {
      "id": "lnm-connectome",
      "name": "DA-LNM connectome bundle (user-supplied)",
      "description": "Per-subject component covariances used for degree-adjusted lesion network mapping. Any bundle produced by the DA-LNM preparation stage works, including a GSP1000 rebuild.",
      "type": "slot",
      "tier": "optional",
      "unlocks": [
        "lnm"
      ],
      "envVar": "LNM_BUNDLE",
      "license": {
        "spdx": "LicenseRef-HCP-DUT",
        "attribution": "Derived from HCP resting-state connectivity (DA-LNM v2.1, see DaLnm/DA-LNM_Methods.pdf). Subject to the HCP Open Access Data Use Terms.",
        "redistributable": false,
        "provenanceReview": "RESOLVED: treat as non-redistributable. Built from HCP PTN1200 (HCP1200_Parcellation_Timeseries_Netmats, ~1003 subjects). DA-LNM_Methods section 'Access terms' states the WU-Minn HCP Open Access Data Use Terms restrict redistribution to users who have themselves registered and accepted them, and that the derived bundle should be treated accordingly. Users must obtain or rebuild it themselves and sideload. The same document names the GSP1000 normative connectome as the substrate to use where those terms are impractical - that is the route to a redistributable LNM module."
      },
      "sources": [
        {
          "type": "sideload"
        }
      ],
      "slot": {
        "directory": "lnm",
        "extensions": [
          ".npz"
        ],
        "validator": "lnm-bundle",
        "dropInHint": "Drop a DA-LNM .npz bundle into this folder."
      }
    },
